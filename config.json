{
  "listen": "0.0.0.0:8080",
  "routes": [
    {
      "id": "api",
      "prefix": "/api/v1",
      "backends": ["backend-1:3000", "backend-2:3000", "chaos:3000"],
      "lb": "least-connections",
      "rate_limit": { "per_ip": 20, "per_seconds": 10, "burst": 5 },
      "circuit": {
        "consecutive_failures": 3,
        "cooldown_s": 20,
        "halfopen_probes": 2
      }
    }
  ],
  "health": {
    "path": "/healthz",
    "interval_s": 4,
    "timeout_s": 2,
    "unhealthy_threshold": 2
  }
}
